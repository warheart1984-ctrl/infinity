{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task_skills_request.v1",
  "title": "TaskSkillsRequest",
  "description": "Canonical AAIS Task & Skills Bus request — provider-agnostic, governed, replayable. Accepts camelCase or snake_case.",
  "type": "object",
  "required": ["intent"],
  "additionalProperties": true,
  "properties": {
    "request_id": { "type": "string" },
    "requestId": { "type": "string" },
    "intent": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "required": ["raw"],
          "properties": {
            "raw": { "type": "string" },
            "type": {
              "type": "string",
              "enum": ["task", "skill", "workflow", "picture", "mixed", "unknown"]
            },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "tags": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "context": {
      "type": "object",
      "properties": {
        "user": { "type": "string" },
        "workspace": { "type": "string" },
        "project": { "type": "string" }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "action", "target"],
        "properties": {
          "id": { "type": "string" },
          "action": { "type": "string" },
          "target": { "type": "string" },
          "constraints": { "type": "object" }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "action", "target"],
        "properties": {
          "id": { "type": "string" },
          "action": { "type": "string" },
          "target": { "type": "string" },
          "style": { "type": "string" }
        }
      }
    },
    "pictures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "action", "target"],
        "properties": {
          "id": { "type": "string" },
          "action": { "type": "string" },
          "target": { "type": "string" },
          "engine": { "type": "string" },
          "params": { "type": "object" }
        }
      }
    },
    "policy": {
      "type": "object",
      "properties": {
        "risk_level": { "type": "string", "enum": ["low", "normal", "high"] },
        "riskLevel": { "type": "string", "enum": ["low", "normal", "high"] },
        "allowed_providers": { "type": "array", "items": { "type": "string" } },
        "allowedProviders": { "type": "array", "items": { "type": "string" } }
      }
    },
    "force_demo": { "type": "boolean" },
    "require_live": { "type": "boolean" },
    "text": { "type": "string" },
    "prompt": { "type": "string" },
    "ask": { "type": "string" }
  }
}
